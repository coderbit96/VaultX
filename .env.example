# Reference only. Keep your existing .env.local; do not replace it with this file.
# Fill only missing values locally. Never commit credentials or paste them into chat.
# MongoDB Atlas connection string and existing database name (server only).
MONGODB_URI=
MONGODB_DB_NAME=
# Existing Cloudinary product environment credentials (server only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Auth.js sign-in gate. Keep the existing secret; use at least 32 random bytes.
AUTH_SECRET=
# Only this email may sign in. Set this yourself in .env.local.
AUTH_OWNER_EMAIL=
# Deployed HTTPS site origin for Auth.js callbacks (for example, https://your-domain.example).
NEXTAUTH_URL=
# Public origin only; do not put secrets in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_APP_URL=
# Optional passkey origin and relying-party host for an HTTPS deployment.
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=
