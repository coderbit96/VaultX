{
  "name": "vaultx",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/prepare-video-assets.mjs && node scripts/build-offline-viewer.mjs",
    "prebuild": "node scripts/check-host-compatibility.mjs && node scripts/prepare-video-assets.mjs && node scripts/build-offline-viewer.mjs",
    "build": "next build",
    "verify:production": "npm run lint && npm run typecheck && npm test && npm run build && npm run security:bundle-check",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "config:check": "tsx scripts/check-environment.ts",
    "security:bundle-check": "tsx scripts/check-client-bundle-secrets.ts",
    "security:git-check": "tsx scripts/check-git-secrets.ts",
    "security:browser-check": "tsx scripts/check-folder-ui.ts --security-only",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:check": "tsx scripts/check-mongodb.ts",
    "gallery:db-check": "tsx scripts/check-gallery-database.ts",
    "gallery:index-audit": "tsx scripts/audit-gallery-indexes.ts",
    "gallery:index-repair": "tsx scripts/repair-gallery-indexes.ts",
    "migration:media:dry-run": "tsx scripts/audit-media-migration.ts",
    "db:indexes": "tsx scripts/create-model-indexes.ts",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "db:owner-race-check": "tsx scripts/check-owner-uniqueness.ts",
    "owner:status": "tsx scripts/check-owner-status.ts",
    "auth:check": "tsx scripts/check-auth-integration.ts",
    "settings:check": "tsx scripts/check-settings-integration.ts",
    "device:check": "tsx scripts/check-device-auth.ts",
    "passkey:browser-check": "tsx scripts/check-passkey-browser.ts",
    "lock:check": "tsx scripts/check-lock-http.ts",
    "folders:ui-check": "tsx scripts/check-folder-ui.ts",
    "pwa:check": "tsx scripts/check-pwa-browser.ts",
    "offline:check": "tsx scripts/check-offline-browser.ts",
    "image:check": "tsx scripts/check-image-optimizer.ts",
    "prevideo:check": "node scripts/prepare-video-assets.mjs",
    "video:check": "tsx scripts/check-video-optimizer.ts",
    "uploads:reconcile": "tsx scripts/reconcile-uploads.ts",
    "recovery:run": "tsx scripts/reconcile.ts",
    "deletions:reconcile": "tsx scripts/reconcile-deletions.ts",
    "deletions:live-check": "tsx scripts/check-file-deletion-live.ts --live",
    "deletions:folder-check": "tsx scripts/check-folder-deletion-live.ts --live",
    "deletions:folder-provider-check": "tsx scripts/check-folder-deletion-provider-live.ts --live",
    "uploads:live-check": "tsx scripts/check-upload-transfer-live.ts --live",
    "uploads:integration-check": "tsx scripts/check-upload-integration.ts --live",
    "media:access-check": "tsx scripts/check-ciphertext-access-live.ts --live",
    "recovery:stored-check": "tsx scripts/check-recovery-stored-live.ts --live"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@inquirer/password": "5.2.3",
    "@next/env": "16.4.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "argon2": "0.45.1",
    "cloudinary": "2.11.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "1.57.0",
    "mongodb": "7.7.0",
    "mongoose": "9.11.3",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.64.1",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
